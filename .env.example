# Cloudflare DB and BUCKET are platform bindings from .openai/hosting.json.
# Local runtime storage is separate from hosted customer data.
# Configure this value through Sites environment settings in production.
# For a deliberate local delivery test, put it in ignored .dev.vars.
# Leaving it unset disables outbound notifications locally.
FORMSPREE_ENDPOINT=https://formspree.io/f/xzerbjjy
# Recipient: confirm info@promomerch.ca in the Formspree dashboard.
# The public form endpoint is not an API secret. No mail API key is required.
# Never commit credentials, customer records or uploaded artwork.

# WHC build: npm run build:whc (selects the public domain and standalone runtime).
# WHC Node 24 application settings; use the account's private sibling directory:
# PROMOMERCH_DATA_DIR=/home/CPANEL_USER/promomerch-data
# PROMOMERCH_ORIGIN=https://promomerch.ca
# Runtime notification endpoint is the same FORMSPREE_ENDPOINT above.
